<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Ondyxn.UI.Controls.CefBrowserControl">

    <!--
        NO Background set here or on the Panel!
        
        In Avalonia, controls with a Background are hit-testable, meaning they
        intercept pointer events BEFORE they reach child controls. Since we want
        events to pass directly to the AvaloniaCefBrowser (which handles its own
        input via CEF's native event loop), we must NOT set Background on any
        parent container. The AvaloniaCefBrowser control itself is already hit-testable
        because it renders its own content via CEF's off-screen rendering.
    -->
    <Panel x:Name="BrowserHost"/>
</UserControl>
