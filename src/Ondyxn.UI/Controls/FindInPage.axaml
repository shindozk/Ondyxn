<Border xmlns="https://github.com/avaloniaui"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         x:Class="Ondyxn.UI.Controls.FindInPage"
         Background="#E0101018"
         BorderBrush="#20FFFFFF"
         BorderThickness="1"
         CornerRadius="8"
         Padding="8,6"
         HorizontalAlignment="Right"
         VerticalAlignment="Top"
         Margin="0,8,12,0"
         IsVisible="False">

    <StackPanel Orientation="Horizontal" Spacing="6">
        <!-- Search input -->
        <TextBox Name="SearchBox"
                 MinWidth="200"
                 Height="28"
                 FontSize="13"
                 Background="#15FFFFFF"
                 BorderBrush="#15FFFFFF"
                 BorderThickness="1"
                 CornerRadius="6"
                 Foreground="White"
                 Watermark="Find in page..."
                 KeyDown="OnSearchKeyDown"/>

        <!-- Match count -->
        <TextBlock Name="MatchCount"
                   Text="0/0"
                   FontSize="11"
                   Foreground="#80FFFFFF"
                   VerticalAlignment="Center"
                   MinWidth="40"/>

        <!-- Previous match -->
        <Button Classes="tool-btn"
                Width="24" Height="24"
                Click="OnPreviousClick"
                ToolTip.Tip="Previous (Shift+Enter)">
            <PathIcon Data="{StaticResource IconBack}" Width="10" Height="10"/>
        </Button>

        <!-- Next match -->
        <Button Classes="tool-btn"
                Width="24" Height="24"
                Click="OnNextClick"
                ToolTip.Tip="Next (Enter)">
            <PathIcon Data="{StaticResource IconForward}" Width="10" Height="10"/>
        </Button>

        <!-- Close -->
        <Button Classes="tool-btn"
                Width="24" Height="24"
                Click="OnCloseClick"
                ToolTip.Tip="Close (Escape)">
            <PathIcon Data="{StaticResource IconClose}" Width="10" Height="10"/>
        </Button>
    </StackPanel>
</Border>
