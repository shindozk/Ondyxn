<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ondyxn.UI.ViewModels"
             x:Class="Ondyxn.UI.Controls.Omnibox"
             x:DataType="vm:BrowserViewModel">

    <Border Classes="omnibox"
            Padding="16,0"
            Height="44"
            MaxWidth="560"
            HorizontalAlignment="Center">

        <Grid ColumnDefinitions="Auto,*,Auto">
            
            <!-- Left side: Lock icon + URL text -->
            <StackPanel Grid.Column="0" 
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Spacing="8">
                
                <!-- Lock icon (secure) -->
                <PathIcon Data="{StaticResource IconLock}"
                          Width="16" Height="16"
                          Foreground="{DynamicResource M3PrimaryBrush}"
                          VerticalAlignment="Center"/>

                <!-- URL display (click to edit) -->
                <TextBlock Name="UrlDisplay"
                           Text="{Binding OmniboxText}"
                           FontSize="14"
                           FontWeight="Regular"
                           FontFamily="Inter, Segoe UI, system-ui"
                           Foreground="{DynamicResource M3OnSurfaceBrush}"
                           VerticalAlignment="Center"
                           Cursor="IBeam"
                           IsHitTestVisible="True"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="480"/>
                
                <!-- Hidden TextBox for editing -->
                <TextBox Name="UrlTextBox"
                         Text="{Binding OmniboxText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         IsVisible="False"
                         KeyDown="Omnibox_KeyDown"
                         Background="Transparent"
                         BorderThickness="0"
                         FontSize="14"
                         FontFamily="Inter, Segoe UI, system-ui"
                         Foreground="{DynamicResource M3OnSurfaceBrush}"
                         CaretBrush="{DynamicResource M3PrimaryBrush}"
                         VerticalContentAlignment="Center"
                         Padding="0"
                         MinWidth="300"/>
            </StackPanel>

            <!-- Right side: Bookmark star -->
            <Button Grid.Column="1"
                    Classes="m3-icon-button"
                    Command="{Binding ToggleBookmarkCommand}"
                    ToolTip.Tip="Bookmark this page (Ctrl+D)">
                <PathIcon Data="{StaticResource IconStar}" 
                          Width="18" Height="18"
                          Foreground="{DynamicResource M3OnSurfaceVariantBrush}"/>
            </Button>
        </Grid>
    </Border>
</UserControl>