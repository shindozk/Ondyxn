<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ==================================================================== -->
    <!-- MATERIAL YOU COMMON COMMAND BUTTONS                                  -->
    <!-- ==================================================================== -->

    <!-- Tool button (toolbar icon buttons) -->
    <Style Selector="Button.m3-tool-btn">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource M3OnSurfaceVariantBrush}"/>
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="CornerRadius" Value="{DynamicResource M3ShapeFull}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Opacity" Value="0.8"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12"/>
                <DoubleTransition Property="Opacity" Duration="0:0:0.12"/>
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Button.m3-tool-btn:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource M3StateLayerHover}"/>
        <Setter Property="Foreground" Value="{DynamicResource M3OnSurfaceBrush}"/>
        <Setter Property="Opacity" Value="1"/>
    </Style>

    <Style Selector="Button.m3-tool-btn:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource M3StateLayerPressed}"/>
    </Style>

    <!-- Window control buttons -->
    <Style Selector="Button.m3-window-btn">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource M3OnSurfaceVariantBrush}"/>
        <Setter Property="Width" Value="44"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="CornerRadius" Value="{DynamicResource M3ShapeSmall}"/>
    </Style>

    <Style Selector="Button.m3-window-btn:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource M3StateLayerHover}"/>
        <Setter Property="Foreground" Value="{DynamicResource M3OnSurfaceBrush}"/>
    </Style>

    <Style Selector="Button.m3-window-btn-close:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource M3ErrorContainerBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource M3OnErrorContainerBrush}"/>
    </Style>

    <!-- Profile avatar button -->
    <Style Selector="Button.m3-avatar-btn">
        <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerHighBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource M3OnSurfaceVariantBrush}"/>
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="CornerRadius" Value="{DynamicResource M3ShapeFull}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource M3OutlineVariantBrush}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.m3-avatar-btn:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource M3StateLayerHover}"/>
    </Style>

    <!-- Accent button (for primary actions like search submit) -->
    <Style Selector="Button.m3-accent-btn">
        <Setter Property="Background" Value="{DynamicResource M3PrimaryContainerBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource M3OnPrimaryContainerBrush}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource M3ShapeFull}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="20,10"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="MinHeight" Value="40"/>
    </Style>

    <Style Selector="Button.m3-accent-btn:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource M3PrimaryBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource M3OnPrimaryBrush}"/>
    </Style>

    <!-- Quick link circle -->
    <Style Selector="Border.m3-quick-link">
        <Setter Property="Width" Value="56"/>
        <Setter Property="Height" Value="56"/>
        <Setter Property="CornerRadius" Value="28"/>
        <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerLowBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource M3OutlineVariantBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12"/>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.12"/>
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Border.m3-quick-link:pointerover">
        <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource M3OutlineBrush}"/>
    </Style>

</Styles>