<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================================================================ -->
    <!-- PREMIUM OMNIBOX / ADDRESS BAR — Arc Browser Inspired            -->
    <!-- ================================================================ -->

    <Style Selector="Border.omnibox">
        <Setter Property="Background" Value="{DynamicResource BgSurfaceBrush}"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="MaxWidth" Value="560"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15"/>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Border.omnibox:pointerover">
        <Setter Property="Background" Value="{DynamicResource BgElevatedBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderHoverBrush}"/>
    </Style>

    <Style Selector="Border.omnibox:focus-within">
        <Setter Property="Background" Value="{DynamicResource BgElevatedBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
    </Style>

    <!-- URL Display Text -->
    <Style Selector="TextBlock#UrlDisplay">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="FontFamily" Value="Inter, Segoe UI, system-ui"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Opacity" Value="0.85"/>
    </Style>

    <Style Selector="TextBlock#UrlDisplay:pointerover">
        <Setter Property="Opacity" Value="1"/>
    </Style>

    <!-- Lock Icon -->
    <Style Selector="Border.omnibox PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Width" Value="14"/>
        <Setter Property="Height" Value="14"/>
    </Style>

    <!-- TextBox (edit mode) -->
    <Style Selector="Border.omnibox TextBox#UrlTextBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentSoftBrush}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="FontFamily" Value="Inter, Segoe UI, system-ui"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Border.omnibox TextBox#UrlTextBox /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="0"/>
    </Style>

    <Style Selector="Border.omnibox TextBox#UrlTextBox /template/ TextBlock#PART_WatermarkTextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
        <Setter Property="Opacity" Value="0.5"/>
        <Setter Property="FontStyle" Value="Normal"/>
    </Style>

    <!-- Bookmark Star Button in Omnibox -->
    <Style Selector="Border.omnibox Button.icon-btn">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="CornerRadius" Value="7"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Border.omnibox Button.icon-btn:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BgHoverBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

</Styles>