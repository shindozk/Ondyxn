<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========== Omnibox Container (liquid glass) ========== -->
    <Style Selector="Border.omnibox">
        <Setter Property="Background" Value="#12FFFFFF"/>
        <Setter Property="CornerRadius" Value="18"/>
        <Setter Property="BorderBrush" Value="#0AFFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.2"/>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.2"/>
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Border.omnibox:pointerover">
        <Setter Property="Background" Value="#18FFFFFF"/>
        <Setter Property="BorderBrush" Value="#12FFFFFF"/>
    </Style>

    <!-- Focus state -->
    <Style Selector="Border.omnibox:focus-within">
        <Setter Property="Background" Value="#1AFFFFFF"/>
        <Setter Property="BorderBrush" Value="#20FFFFFF"/>
    </Style>

    <!-- ========== URL Display Text ========== -->
    <Style Selector="TextBlock#UrlDisplay">
        <Setter Property="Foreground" Value="#D0FFFFFF"/>
        <Setter Property="Opacity" Value="0.85"/>
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.12"/>
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="TextBlock#UrlDisplay:pointerover">
        <Setter Property="Opacity" Value="1"/>
    </Style>

    <!-- ========== TextBox (edit mode) ========== -->
    <Style Selector="Border.omnibox TextBox#UrlTextBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="#E0FFFFFF"/>
        <Setter Property="CaretBrush" Value="#00D4FF"/>
        <Setter Property="SelectionBrush" Value="#3000D4FF"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <!-- Remove default TextBox template styling -->
    <Style Selector="Border.omnibox TextBox#UrlTextBox /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="0"/>
    </Style>

    <!-- Watermark text -->
    <Style Selector="Border.omnibox TextBox#UrlTextBox /template/ TextBlock#PART_WatermarkTextBlock">
        <Setter Property="Foreground" Value="#40FFFFFF"/>
        <Setter Property="FontStyle" Value="Normal"/>
    </Style>
</Styles>
