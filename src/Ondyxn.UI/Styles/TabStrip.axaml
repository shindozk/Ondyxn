<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================================================================ -->
    <!-- PREMIUM TAB STRIP — Arc Browser Inspired                        -->
    <!-- ================================================================ -->

    <Style Selector="Border.m3-tab">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="MinWidth" Value="40"/>
        <Setter Property="MaxWidth" Value="180"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12"/>
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Border.m3-tab:pointerover">
        <Setter Property="Background" Value="{DynamicResource BgHoverBrush}"/>
    </Style>

    <Style Selector="Border.m3-tab.active">
        <Setter Property="Background" Value="{DynamicResource BgSurfaceBrush}"/>
    </Style>

    <Style Selector="Border.m3-tab.active:pointerover">
        <Setter Property="Background" Value="{DynamicResource BgOverlayBrush}"/>
    </Style>

    <!-- Tab text -->
    <Style Selector="Border.m3-tab > Grid > TextBlock">
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style Selector="Border.m3-tab.active > Grid > TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="FontWeight" Value="Medium"/>
    </Style>

    <!-- Tab favicon -->
    <Style Selector="Border.m3-tab > Grid > Panel > Ellipse">
        <Setter Property="Fill" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Opacity" Value="0.7"/>
    </Style>

    <Style Selector="Border.m3-tab > Grid > Panel > PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
        <Setter Property="Width" Value="13"/>
        <Setter Property="Height" Value="13"/>
    </Style>

    <Style Selector="Border.m3-tab.active > Grid > Panel > PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>

    <!-- Tab close button -->
    <Style Selector="Button.m3-tab-close">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
        <Setter Property="Width" Value="22"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Opacity" Value="0"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Border.m3-tab:pointerover Button.m3-tab-close">
        <Setter Property="Opacity" Value="1"/>
    </Style>

    <Style Selector="Button.m3-tab-close:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BgHoverBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

    <!-- New tab button -->
    <Style Selector="Button.m3-tab-new">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.m3-tab-new:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BgHoverBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

</Styles>