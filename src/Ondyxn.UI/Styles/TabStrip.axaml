<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========== Tab pill (default) ========== -->
    <Style Selector="Border.tab-pill">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="MinWidth" Value="60"/>
        <Setter Property="MaxWidth" Value="160"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="ClipToBounds" Value="True"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15"/>
            </Transitions>
        </Setter>
    </Style>

    <!-- Hover state -->
    <Style Selector="Border.tab-pill:pointerover">
        <Setter Property="Background" Value="#15FFFFFF"/>
    </Style>

    <!-- ========== Active tab pill (highlighted) ========== -->
    <Style Selector="Border.tab-pill.active">
        <Setter Property="Background" Value="#22FFFFFF"/>
        <Setter Property="BorderBrush" Value="#15FFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style Selector="Border.tab-pill.active:pointerover">
        <Setter Property="Background" Value="#2AFFFFFF"/>
    </Style>

    <!-- ========== Tab close button ========== -->
    <Style Selector="Button.tab-close">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#80FFFFFF"/>
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Opacity" Value="0"/>
    </Style>

    <Style Selector="Border.tab-pill:pointerover Button.tab-close">
        <Setter Property="Opacity" Value="1"/>
    </Style>

    <Style Selector="Button.tab-close:pointerover">
        <Setter Property="Background" Value="#30FFFFFF"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <Style Selector="Button.tab-close:pressed">
        <Setter Property="Background" Value="#40FFFFFF"/>
    </Style>
</Styles>
