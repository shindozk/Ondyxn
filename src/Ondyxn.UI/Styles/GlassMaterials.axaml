<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========== Liquid Glass Card ========== -->
    <Style Selector="Border.glass-card">
        <Setter Property="Background" Value="#0AFFFFFF"/>
        <Setter Property="BorderBrush" Value="#08FFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="16"/>
    </Style>

    <!-- ========== Bento cards ========== -->
    <Style Selector="Border.bento-card">
        <Setter Property="MinHeight" Value="110"/>
    </Style>

    <Style Selector="Border.bento-large">
        <Setter Property="MinHeight" Value="140"/>
    </Style>

    <Style Selector="Border.bento-card:pointerover">
        <Setter Property="Background" Value="#14FFFFFF"/>
    </Style>

    <!-- ========== Glass pill ========== -->
    <Style Selector="Border.glass-pill">
        <Setter Property="Background" Value="#08FFFFFF"/>
        <Setter Property="BorderBrush" Value="#06FFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
    </Style>

    <!-- ========== Tool button (liquid glass) ========== -->
    <Style Selector="Button.tool-btn">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#A0FFFFFF"/>
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Opacity" Value="0.8"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15"/>
                <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Button.tool-btn:pointerover">
        <Setter Property="Background" Value="#12FFFFFF"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Opacity" Value="1"/>
    </Style>

    <Style Selector="Button.tool-btn:pressed">
        <Setter Property="Background" Value="#1AFFFFFF"/>
    </Style>

    <!-- ========== Icon button (generic) ========== -->
    <Style Selector="Button.icon-btn">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.icon-btn:pointerover">
        <Setter Property="Background" Value="#18FFFFFF"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <Style Selector="Button.icon-btn:pressed">
        <Setter Property="Background" Value="#22FFFFFF"/>
    </Style>

    <!-- ========== Window control buttons (liquid glass) ========== -->
    <Style Selector="Button.window-btn">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#80FFFFFF"/>
        <Setter Property="Width" Value="38"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12"/>
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Button.window-btn:pointerover">
        <Setter Property="Background" Value="#12FFFFFF"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <Style Selector="Button.window-btn-close:pointerover">
        <Setter Property="Background" Value="#E81123"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <!-- ========== Accent button ========== -->
    <Style Selector="Button.accent-btn">
        <Setter Property="Background" Value="{DynamicResource OndyxnAccent}"/>
        <Setter Property="Foreground" Value="#FF0B0E14"/>
        <Setter Property="CornerRadius" Value="18"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style Selector="Button.accent-btn:pointerover">
        <Setter Property="Background" Value="{DynamicResource OndyxnAccentLight}"/>
    </Style>

    <!-- ========== Site tile (Top Sites) ========== -->
    <Style Selector="StackPanel.site-tile">
        <Setter Property="Spacing" Value="0"/>
    </Style>

    <Style Selector="Border.site-icon">
        <Setter Property="Background" Value="#08FFFFFF"/>
        <Setter Property="BorderBrush" Value="#06FFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style Selector="StackPanel.site-tile:pointerover Border.site-icon">
        <Setter Property="Background" Value="#14FFFFFF"/>
        <Setter Property="BorderBrush" Value="#14FFFFFF"/>
    </Style>

    <!-- ========== Sidebar button (liquid glass) ========== -->
    <Style Selector="ToggleButton.side-btn">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#80FFFFFF"/>
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0,1"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12"/>
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="ToggleButton.side-btn:pointerover">
        <Setter Property="Background" Value="#10FFFFFF"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <Style Selector="ToggleButton.side-btn:checked">
        <Setter Property="Background" Value="#1200D4FF"/>
        <Setter Property="Foreground" Value="#00D4FF"/>
    </Style>

    <!-- ========== Tab new button (liquid glass) ========== -->
    <Style Selector="Button.tab-new-btn">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#80FFFFFF"/>
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12"/>
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Button.tab-new-btn:pointerover">
        <Setter Property="Background" Value="#15FFFFFF"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <!-- ========== Quick link circles ========== -->
    <Style Selector="Border.quick-link">
        <Setter Property="Width" Value="52"/>
        <Setter Property="Height" Value="52"/>
        <Setter Property="CornerRadius" Value="26"/>
        <Setter Property="Background" Value="#25FFFFFF"/>
        <Setter Property="BorderBrush" Value="#18FFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15"/>
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Border.quick-link:pointerover">
        <Setter Property="Background" Value="#35FFFFFF"/>
        <Setter Property="BorderBrush" Value="#28FFFFFF"/>
    </Style>

    <!-- ========== Glass card pointerover ========== -->
    <Style Selector="Border.glass-card:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#14FFFFFF"/>
    </Style>
    <Style Selector="Border.glass-card:pointerover">
        <Setter Property="Background" Value="#12FFFFFF"/>
    </Style>
</Styles>
