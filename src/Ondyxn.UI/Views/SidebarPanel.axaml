<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ondyxn.UI.ViewModels"
             xmlns:models="using:Ondyxn.Core.Models"
             x:Class="Ondyxn.UI.Views.SidebarPanel"
             Background="Transparent"
             Width="280">

    <Border Background="{DynamicResource BgBaseBrush}"
            BorderBrush="{DynamicResource BorderSoftBrush}"
            BorderThickness="1,0,0,0">
        <DockPanel>
            <!-- Close button -->
            <Button DockPanel.Dock="Top"
                    Classes="icon-btn"
                    HorizontalAlignment="Right"
                    Margin="0,8,8,0"
                    Command="{Binding $parent[UserControl].((vm:BrowserViewModel)DataContext).ToggleSidebarCommand}">
                <PathIcon Data="{StaticResource IconClose}" Width="12" Height="12"/>
            </Button>

            <!-- Tab selector -->
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="4" Margin="12,8">
                <Button Classes="ghost-btn" Width="80" Height="28"
                        Tag="0" Click="OnSectionClick"
                        FontSize="11">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <PathIcon Data="{StaticResource IconBookmark}" Width="10" Height="10"/>
                        <TextBlock Text="Bookmarks" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Classes="ghost-btn" Width="60" Height="28"
                        Tag="1" Click="OnSectionClick"
                        FontSize="11">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <PathIcon Data="{StaticResource IconHistory}" Width="10" Height="10"/>
                        <TextBlock Text="History" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Classes="ghost-btn" Width="80" Height="28"
                        Tag="2" Click="OnSectionClick"
                        FontSize="11">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <PathIcon Data="{StaticResource IconDownloads}" Width="10" Height="10"/>
                        <TextBlock Text="Downloads" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Content area -->
            <Panel>
                <!-- Bookmarks panel -->
                <Border Padding="12" IsVisible="False" x:Name="BookmarksPanel">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Bookmarks" FontSize="13"
                                   FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,0,0,8"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <ItemsControl x:Name="BookmarksList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:BookmarkModel">
                                            <Border Padding="10,8" Margin="0,2" Cursor="Hand"
                                                    Background="{DynamicResource BgElevatedBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <PathIcon Data="{StaticResource IconBookmark}" Width="12" Height="12"
                                                              Foreground="{DynamicResource WarningBrush}"/>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Title}" FontSize="12"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   TextTrimming="CharacterEllipsis" MaxWidth="200"/>
                                                        <TextBlock Text="{Binding Url}" FontSize="10"
                                                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                                                   TextTrimming="CharacterEllipsis" MaxWidth="200"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="No bookmarks yet" FontSize="12"
                                           Foreground="{DynamicResource TextDisabledBrush}"
                                           HorizontalAlignment="Center" Margin="0,20" IsVisible="False"/>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- History panel -->
                <Border Padding="12" IsVisible="False" x:Name="HistoryPanel">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="History" FontSize="13"
                                   FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,0,0,8"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <ItemsControl x:Name="HistoryList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:HistoryEntry">
                                            <Border Padding="10,8" Margin="0,2" Cursor="Hand"
                                                    Background="{DynamicResource BgElevatedBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <PathIcon Data="{StaticResource IconHistory}" Width="12" Height="12"
                                                              Foreground="{DynamicResource AccentBrush}"/>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Title}" FontSize="12"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   TextTrimming="CharacterEllipsis" MaxWidth="200"/>
                                                        <TextBlock Text="{Binding Url}" FontSize="10"
                                                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                                                   TextTrimming="CharacterEllipsis" MaxWidth="200"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="No history yet" FontSize="12"
                                           Foreground="{DynamicResource TextDisabledBrush}"
                                           HorizontalAlignment="Center" Margin="0,20" IsVisible="False"/>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- Downloads panel -->
                <Border Padding="12" IsVisible="False" x:Name="DownloadsPanel">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Downloads" FontSize="13"
                                   FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,0,0,8"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <ItemsControl x:Name="DownloadsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:DownloadModel">
                                            <Border Padding="10,8" Margin="0,2" Cursor="Hand"
                                                    Background="{DynamicResource BgElevatedBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8">
                                                <StackPanel Spacing="4">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <PathIcon Data="{StaticResource IconDownloads}" Width="12" Height="12"
                                                                  Foreground="{DynamicResource SuccessBrush}"/>
                                                        <TextBlock Text="{Binding FileName}" FontSize="12"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   TextTrimming="CharacterEllipsis" MaxWidth="200"/>
                                                    </StackPanel>
                                                    <ProgressBar Value="{Binding Progress}" Minimum="0" Maximum="100" Height="3"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="No downloads" FontSize="12"
                                           Foreground="{DynamicResource TextDisabledBrush}"
                                           HorizontalAlignment="Center" Margin="0,20" IsVisible="False"/>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Panel>
        </DockPanel>
    </Border>
</UserControl>