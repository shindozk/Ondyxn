<Border xmlns="https://github.com/avaloniaui"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:styles="clr-namespace:Material.Styles;assembly=Material.Styles"
         x:Class="Ondyxn.UI.Views.SecurityInfoPopup"
         Background="#E0101018"
         BorderBrush="#20FFFFFF"
         BorderThickness="1"
         CornerRadius="12"
         Padding="16"
         MinWidth="280"
         MaxWidth="320">

    <StackPanel Spacing="12">
        <!-- Header -->
        <Grid ColumnDefinitions="Auto,*">
            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20"
                    Background="#104ADE80" Margin="0,0,12,0">
                <PathIcon Data="{StaticResource IconLock}" Width="18" Height="18"
                          Foreground="#4ADE80" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="SiteUrl" Text="example.com" FontSize="14" FontWeight="SemiBold"
                           Foreground="White" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="SecurityStatus" Text="Connection is secure" FontSize="11"
                           Foreground="#4ADE80"/>
            </StackPanel>
        </Grid>

        <Border Height="1" Background="#15FFFFFF"/>

        <!-- Connection info -->
        <StackPanel Spacing="8">
            <TextBlock Text="Connection" FontSize="11" FontWeight="SemiBold" Foreground="#80FFFFFF"/>

            <Grid ColumnDefinitions="Auto,*">
                <TextBlock Grid.Column="0" Text="Protocol:" FontSize="11" Foreground="#60FFFFFF" Margin="0,0,8,0"/>
                <TextBlock Grid.Column="1" x:Name="ProtocolText" Text="HTTPS" FontSize="11" Foreground="#C0FFFFFF"/>
            </Grid>

            <Grid ColumnDefinitions="Auto,*">
                <TextBlock Grid.Column="0" Text="Cipher:" FontSize="11" Foreground="#60FFFFFF" Margin="0,0,8,0"/>
                <TextBlock Grid.Column="1" x:Name="CipherText" Text="TLS 1.3" FontSize="11" Foreground="#C0FFFFFF"/>
            </Grid>

            <Grid ColumnDefinitions="Auto,*">
                <TextBlock Grid.Column="0" Text="Certificate:" FontSize="11" Foreground="#60FFFFFF" Margin="0,0,8,0"/>
                <TextBlock Grid.Column="1" x:Name="CertText" Text="Valid" FontSize="11" Foreground="#4ADE80"/>
            </Grid>
        </StackPanel>

        <Border Height="1" Background="#15FFFFFF"/>

        <!-- Site info -->
        <StackPanel Spacing="8">
            <TextBlock Text="Site information" FontSize="11" FontWeight="SemiBold" Foreground="#80FFFFFF"/>

            <Grid ColumnDefinitions="Auto,*">
                <TextBlock Grid.Column="0" Text="Trackers blocked:" FontSize="11" Foreground="#60FFFFFF" Margin="0,0,8,0"/>
                <TextBlock Grid.Column="1" x:Name="TrackersText" Text="0" FontSize="11" Foreground="#C0FFFFFF"/>
            </Grid>

            <Grid ColumnDefinitions="Auto,*">
                <TextBlock Grid.Column="0" Text="Ads blocked:" FontSize="11" Foreground="#60FFFFFF" Margin="0,0,8,0"/>
                <TextBlock Grid.Column="1" x:Name="AdsText" Text="0" FontSize="11" Foreground="#C0FFFFFF"/>
            </Grid>
        </StackPanel>

        <Border Height="1" Background="#15FFFFFF"/>

        <!-- Permissions -->
        <StackPanel Spacing="6">
            <TextBlock Text="Permissions" FontSize="11" FontWeight="SemiBold" Foreground="#80FFFFFF"/>
            <TextBlock Text="Click to manage site permissions" FontSize="10" Foreground="#50FFFFFF"/>
        </StackPanel>
    </StackPanel>
</Border>
