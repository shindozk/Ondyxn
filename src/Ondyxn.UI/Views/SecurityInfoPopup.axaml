<Border xmlns="https://github.com/avaloniaui"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         x:Class="Ondyxn.UI.Views.SecurityInfoPopup"
         Background="{DynamicResource BgBaseBrush}"
         BorderBrush="{DynamicResource BorderBrush}"
         BorderThickness="1"
         CornerRadius="12"
         Padding="16"
         MinWidth="280"
         MaxWidth="320">

    <StackPanel Spacing="12">
        <!-- Header -->
        <Grid ColumnDefinitions="Auto,*">
            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10"
                    Background="#1522C55E" Margin="0,0,10,0">
                <PathIcon Data="{StaticResource IconLock}" Width="16" Height="16"
                          Foreground="{DynamicResource SuccessBrush}"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="SiteUrl" Text="example.com" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="SecurityStatus" Text="Connection is secure" FontSize="11"
                           Foreground="{DynamicResource SuccessBrush}"/>
            </StackPanel>
        </Grid>

        <Border Height="1" Background="{DynamicResource BorderSoftBrush}"/>

        <!-- Connection info -->
        <StackPanel Spacing="8">
            <TextBlock Text="Connection" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextTertiaryBrush}"/>
            <Grid ColumnDefinitions="Auto,*">
                <TextBlock Grid.Column="0" Text="Protocol:" FontSize="11"
                           Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,8,0"/>
                <TextBlock Grid.Column="1" x:Name="ProtocolText" Text="HTTPS" FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </Grid>
            <Grid ColumnDefinitions="Auto,*">
                <TextBlock Grid.Column="0" Text="Cipher:" FontSize="11"
                           Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,8,0"/>
                <TextBlock Grid.Column="1" x:Name="CipherText" Text="TLS 1.3" FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </Grid>
            <Grid ColumnDefinitions="Auto,*">
                <TextBlock Grid.Column="0" Text="Certificate:" FontSize="11"
                           Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,8,0"/>
                <TextBlock Grid.Column="1" x:Name="CertText" Text="Valid" FontSize="11"
                           Foreground="{DynamicResource SuccessBrush}"/>
            </Grid>
        </StackPanel>

        <Border Height="1" Background="{DynamicResource BorderSoftBrush}"/>

        <!-- Site info -->
        <StackPanel Spacing="8">
            <TextBlock Text="Site information" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextTertiaryBrush}"/>
            <Grid ColumnDefinitions="Auto,*">
                <TextBlock Grid.Column="0" Text="Trackers blocked:" FontSize="11"
                           Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,8,0"/>
                <TextBlock Grid.Column="1" x:Name="TrackersText" Text="0" FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </Grid>
            <Grid ColumnDefinitions="Auto,*">
                <TextBlock Grid.Column="0" Text="Ads blocked:" FontSize="11"
                           Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,8,0"/>
                <TextBlock Grid.Column="1" x:Name="AdsText" Text="0" FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </Grid>
        </StackPanel>

        <Border Height="1" Background="{DynamicResource BorderSoftBrush}"/>

        <!-- Permissions -->
        <StackPanel Spacing="6">
            <TextBlock Text="Permissions" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextTertiaryBrush}"/>
            <TextBlock Text="Click to manage site permissions" FontSize="10"
                       Foreground="{DynamicResource TextDisabledBrush}"/>
        </StackPanel>
    </StackPanel>
</Border>