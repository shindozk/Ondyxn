<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ondyxn.UI.ViewModels"
             x:Class="Ondyxn.UI.Views.NewTabPage"
             x:DataType="vm:BrowserViewModel"
             Background="Transparent">

    <Panel HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="24" HorizontalAlignment="Center" MaxWidth="600">

            <!-- Brand name with globe icon -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
                <Border Width="44" Height="44" CornerRadius="22"
                        Background="#50FFFFFF"
                        BorderBrush="#30FFFFFF" BorderThickness="1">
                    <PathIcon Data="{StaticResource IconLink}"
                              Width="22" Height="22"
                              Foreground="White"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Ondyxn"
                           FontSize="40" FontWeight="Bold"
                           Foreground="White"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Search bar -->
            <Border Background="#40000000"
                    CornerRadius="28"
                    Padding="18,12"
                    BorderBrush="#20FFFFFF" BorderThickness="1">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <PathIcon Grid.Column="0"
                              Data="{StaticResource IconSearch}"
                              Width="18" Height="18"
                              Foreground="#90FFFFFF"
                              VerticalAlignment="Center"
                              Margin="0,0,12,0"/>
                    <TextBox Grid.Column="1"
                             Background="Transparent"
                             BorderThickness="0"
                             FontSize="15"
                             FontFamily="Inter, Segoe UI"
                             Watermark="Search or type a URL"
                             Foreground="White"
                             VerticalContentAlignment="Center"
                             Padding="0"/>
                    <Button Grid.Column="2"
                            Classes="icon-btn"
                            Command="{Binding ToggleBookmarkCommand}"
                            ToolTip.Tip="Bookmark"
                            Margin="8,0,0,0">
                        <PathIcon Data="{StaticResource IconStar}" Width="18" Height="18"
                                  Foreground="#90FFFFFF"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Quick links (3 circles) -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Spacing="32"
                        Margin="0,12,0,0">
                <!-- Google -->
                <StackPanel Spacing="8">
                    <Border Width="56" Height="56" CornerRadius="28"
                            Background="#30FFFFFF"
                            BorderBrush="#20FFFFFF" BorderThickness="1"
                            Cursor="Hand">
                        <TextBlock Text="G" FontSize="22" FontWeight="Bold"
                                   Foreground="#4285F4"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Google" FontSize="12"
                               Foreground="#C0FFFFFF"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- GitHub -->
                <StackPanel Spacing="8">
                    <Border Width="56" Height="56" CornerRadius="28"
                            Background="#30FFFFFF"
                            BorderBrush="#20FFFFFF" BorderThickness="1"
                            Cursor="Hand">
                        <TextBlock Text="G" FontSize="22" FontWeight="Bold"
                                   Foreground="#1DB954"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="GitHub" FontSize="12"
                               Foreground="#C0FFFFFF"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- YouTube -->
                <StackPanel Spacing="8">
                    <Border Width="56" Height="56" CornerRadius="28"
                            Background="#30FFFFFF"
                            BorderBrush="#20FFFFFF" BorderThickness="1"
                            Cursor="Hand">
                        <TextBlock Text="Y" FontSize="22" FontWeight="Bold"
                                   Foreground="#FF0000"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="YouTube" FontSize="12"
                               Foreground="#C0FFFFFF"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Panel>
</UserControl>
