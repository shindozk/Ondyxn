<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ondyxn.UI.ViewModels"
             xmlns:models="using:Ondyxn.Core.Models"
             x:Class="Ondyxn.UI.Views.NewTabPage"
             x:DataType="vm:BrowserViewModel"
             Background="#0A0A0C">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel HorizontalAlignment="Center" MaxWidth="800" Margin="0,40,0,40" Spacing="32">

            <!-- ====== GREETING ====== -->
            <StackPanel Spacing="4">
                <TextBlock Text="{Binding NewTabViewModel.Greeting}"
                           FontSize="32" FontWeight="Light"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="{Binding NewTabViewModel.DateText}"
                           FontSize="14"
                           Foreground="{DynamicResource TextTertiaryBrush}"/>
            </StackPanel>

            <!-- ====== SEARCH BAR ====== -->
            <Border Background="{DynamicResource BgElevatedBrush}"
                    CornerRadius="12"
                    Padding="16,12"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <PathIcon Grid.Column="0"
                              Data="{StaticResource IconSearch}"
                              Width="18" Height="18"
                              Foreground="{DynamicResource TextTertiaryBrush}"
                              VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBox Grid.Column="1"
                             Background="Transparent" BorderThickness="0"
                             FontSize="15"
                             FontFamily="Inter, Segoe UI, system-ui"
                             Watermark="Search the web or enter address"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             VerticalContentAlignment="Center"
                             Padding="0"/>
                    <Button Grid.Column="2"
                            Classes="accent-btn"
                            Padding="16,8"
                            ToolTip.Tip="Search">
                        <PathIcon Data="{StaticResource IconSearch}" Width="16" Height="16"
                                  Foreground="#0A0A0C"/>
                    </Button>
                </Grid>
            </Border>

            <!-- ====== QUICK LINKS ====== -->
            <ItemsControl ItemsSource="{Binding NewTabViewModel.QuickLinks}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="14"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:QuickLinkModel">
                        <StackPanel Spacing="8" Cursor="Hand">
                            <Border Classes="m3-quick-link"
                                    ToolTip.Tip="{Binding Title}"
                                    Width="52" Height="52" CornerRadius="16"
                                    Background="{DynamicResource BgSurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1">
                                <Panel>
                                    <TextBlock Text="{Binding FaviconLetter}"
                                               FontSize="20" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <PathIcon Data="{StaticResource IconHome}"
                                              Width="22" Height="22"
                                              Foreground="{DynamicResource AccentBrush}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              IsVisible="{Binding FaviconLetter, Converter={x:Static StringConverters.IsNullOrEmpty}}"/>
                                </Panel>
                            </Border>
                            <TextBlock Text="{Binding Title}"
                                       FontSize="10" FontWeight="Medium"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ====== BENTO GRID — Row 1 (Weather + Privacy) ====== -->
            <Grid ColumnDefinitions="2*,*" Margin="0,4,0,0">
                <!-- Weather Widget -->
                <Border Grid.Column="0"
                        Background="{DynamicResource BgElevatedBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="22"
                        Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <Border Width="48" Height="48" CornerRadius="14"
                                Background="{DynamicResource AccentSoftBrush}">
                            <PathIcon Data="{StaticResource IconWeather}" Width="22" Height="22"
                                      Foreground="{DynamicResource AccentBrush}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="3">
                            <TextBlock Text="{Binding NewTabViewModel.Temperature}"
                                       FontSize="28" FontWeight="Medium"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding NewTabViewModel.WeatherText}"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding NewTabViewModel.WeatherDetails}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextTertiaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Privacy Shield Widget -->
                <Border Grid.Column="1"
                        Background="{DynamicResource BgElevatedBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="20"
                        Margin="6,0,0,0">
                    <StackPanel Spacing="10">
                        <Border Width="40" Height="40" CornerRadius="12"
                                Background="#1522C55E">
                            <PathIcon Data="{StaticResource IconShieldCheck}" Width="18" Height="18"
                                      Foreground="{DynamicResource SuccessBrush}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Spacing="3">
                            <TextBlock Text="Privacy Shield"
                                       FontSize="14" FontWeight="Medium"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock FontSize="11"
                                       Foreground="{DynamicResource TextTertiaryBrush}">
                                <Run Text="{Binding NewTabViewModel.BlockedTrackers}"/>
                                <Run Text=" trackers blocked"/>
                            </TextBlock>
                        </StackPanel>
                        <Border Background="{DynamicResource AccentSoftBrush}"
                                CornerRadius="6"
                                Padding="8,3"
                                HorizontalAlignment="Left">
                            <TextBlock Text="Active"
                                       FontSize="10" FontWeight="Medium"
                                       Foreground="{DynamicResource AccentBrush}"/>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ====== BENTO GRID — Row 2 (Top Sites + Bookmarks + Reading) ====== -->
            <Grid ColumnDefinitions="*,*,*" Margin="0,0,0,0">
                <!-- Top Sites -->
                <Border Grid.Column="0"
                        Background="{DynamicResource BgElevatedBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="18"
                        Margin="0,0,6,0">
                    <StackPanel Spacing="10">
                        <Border Width="36" Height="36" CornerRadius="10"
                                Background="{DynamicResource AccentSoftBrush}">
                            <PathIcon Data="{StaticResource IconGlobe}" Width="16" Height="16"
                                      Foreground="{DynamicResource AccentBrush}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Most Visited"
                                   FontSize="13" FontWeight="Medium"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock FontSize="11"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding NewTabViewModel.TopSitesCount}"/>
                            <Run Text=" sites this week"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Bookmarks -->
                <Border Grid.Column="1"
                        Background="{DynamicResource BgElevatedBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="18"
                        Margin="6,0,6,0">
                    <StackPanel Spacing="10">
                        <Border Width="36" Height="36" CornerRadius="10"
                                Background="#15F59E0B">
                            <PathIcon Data="{StaticResource IconBookmark}" Width="16" Height="16"
                                      Foreground="{DynamicResource WarningBrush}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Bookmarks"
                                   FontSize="13" FontWeight="Medium"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock FontSize="11"
                                   Foreground="{DynamicResource TextTertiaryBrush}">
                            <Run Text="{Binding NewTabViewModel.BookmarksCount}"/>
                            <Run Text=" saved"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Reading List -->
                <Border Grid.Column="2"
                        Background="{DynamicResource BgElevatedBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="18"
                        Margin="6,0,0,0">
                    <StackPanel Spacing="10">
                        <Border Width="36" Height="36" CornerRadius="10"
                                Background="#153B82F6">
                            <PathIcon Data="{StaticResource IconReading}" Width="16" Height="16"
                                      Foreground="{DynamicResource InfoBrush}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Reading List"
                                   FontSize="13" FontWeight="Medium"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock FontSize="11"
                                   Foreground="{DynamicResource TextTertiaryBrush}">
                            <Run Text="{Binding NewTabViewModel.ReadingListCount}"/>
                            <Run Text=" unread"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ====== BENTO GRID — Row 3 (Downloads + History + Music) ====== -->
            <Grid ColumnDefinitions="*,*,*">
                <!-- Downloads -->
                <Border Grid.Column="0"
                        Background="{DynamicResource BgElevatedBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="18"
                        Margin="0,0,6,0">
                    <StackPanel Spacing="10">
                        <Border Width="36" Height="36" CornerRadius="10"
                                Background="#1522C55E">
                            <PathIcon Data="{StaticResource IconDownloads}" Width="16" Height="16"
                                      Foreground="{DynamicResource SuccessBrush}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Downloads"
                                   FontSize="13" FontWeight="Medium"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock FontSize="11"
                                   Foreground="{DynamicResource TextTertiaryBrush}">
                            <Run Text="{Binding NewTabViewModel.ActiveDownloads}"/>
                            <Run Text=" active"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- History -->
                <Border Grid.Column="1"
                        Background="{DynamicResource BgElevatedBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="18"
                        Margin="6,0,6,0">
                    <StackPanel Spacing="10">
                        <Border Width="36" Height="36" CornerRadius="10"
                                Background="{DynamicResource AccentSoftBrush}">
                            <PathIcon Data="{StaticResource IconHistory}" Width="16" Height="16"
                                      Foreground="{DynamicResource AccentBrush}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="History"
                                   FontSize="13" FontWeight="Medium"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="View all history"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextTertiaryBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Music -->
                <Border Grid.Column="2"
                        Background="{DynamicResource BgElevatedBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="18"
                        Margin="6,0,0,0">
                    <StackPanel Spacing="10">
                        <Border Width="36" Height="36" CornerRadius="10"
                                Background="#15A855F7">
                            <PathIcon Data="{StaticResource IconMusic}" Width="16" Height="16"
                                      Foreground="#A855F7"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Music"
                                   FontSize="13" FontWeight="Medium"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="Nothing playing"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextTertiaryBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ====== FOOTER ====== -->
            <TextBlock Text="Ondyxn Browser"
                       FontSize="11"
                       Foreground="{DynamicResource TextDisabledBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,20,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>