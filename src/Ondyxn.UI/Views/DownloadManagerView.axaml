<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:Ondyxn.Core.Models"
             xmlns:vm="using:Ondyxn.UI.ViewModels"
             x:Class="Ondyxn.UI.Views.DownloadManagerView"
             x:DataType="vm:DownloadViewModel"
             Background="Transparent">

    <Border Background="{DynamicResource BgBaseBrush}"
            BorderBrush="{DynamicResource BorderSoftBrush}"
            BorderThickness="1,0,0,0">
        <DockPanel>
            <!-- Header -->
            <StackPanel DockPanel.Dock="Top" Margin="12,12,12,8">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="Downloads" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <Button Grid.Column="1" Classes="tool-btn" Width="24" Height="24"
                            ToolTip.Tip="Clear completed"
                            Command="{Binding ClearCompletedCommand}">
                        <PathIcon Data="{StaticResource IconClose}" Width="10" Height="10"/>
                    </Button>
                </Grid>
            </StackPanel>

            <!-- Downloads list -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="12,0">
                    <ItemsControl ItemsSource="{Binding Downloads}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:DownloadModel">
                                <Border Padding="12,10" Margin="0,2"
                                         Background="{DynamicResource BgElevatedBrush}"
                                         BorderBrush="{DynamicResource BorderBrush}"
                                         BorderThickness="1"
                                         CornerRadius="8">
                                    <StackPanel Spacing="6">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <Border Grid.Column="0" Width="32" Height="32" CornerRadius="8"
                                                    Background="{DynamicResource AccentSoftBrush}" Margin="0,0,8,0">
                                                <PathIcon Data="{StaticResource IconDownloads}" Width="14" Height="14"
                                                          Foreground="{DynamicResource AccentBrush}"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FileName}" FontSize="12" FontWeight="Medium"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="180"/>
                                                <TextBlock Text="{Binding Url}" FontSize="10"
                                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="180"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" VerticalAlignment="Center"
                                                       Text="{Binding Progress, StringFormat='{}{0:F0}%'}"
                                                       FontSize="11" Foreground="{DynamicResource AccentBrush}"/>
                                        </Grid>
                                        <ProgressBar Value="{Binding Progress}" Minimum="0" Maximum="100"
                                                     Height="3"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Empty state -->
                    <StackPanel HorizontalAlignment="Center" Margin="0,40" Spacing="8">
                        <PathIcon Data="{StaticResource IconDownloads}" Width="28" Height="28"
                                  Foreground="{DynamicResource TextDisabledBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="No downloads yet" FontSize="13"
                                   Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>