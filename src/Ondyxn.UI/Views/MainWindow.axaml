<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Ondyxn.UI.ViewModels"
        xmlns:views="using:Ondyxn.UI.Views"
        xmlns:controls="using:Ondyxn.UI.Controls"
        x:Class="Ondyxn.UI.Views.MainWindow"
        x:DataType="vm:BrowserViewModel"
        Title="Ondyxn"
        Width="1280" Height="800"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        ExtendClientAreaToDecorationsHint="True"
        SystemDecorations="None">

    <Panel>
        <!-- Full background image -->
        <Image Source="avares://Ondyxn.UI/Assets/background.jpg"
               Stretch="UniformToFill"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               IsHitTestVisible="False"/>

        <!-- Dark overlay -->
        <Rectangle Fill="#35000000"
                   IsHitTestVisible="False"/>

        <DockPanel LastChildFill="True">

            <!-- ===== TAB STRIP (top - ONLY tabs + window controls, fully transparent) ===== -->
            <Border DockPanel.Dock="Top" Height="34"
                    Background="Transparent">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <!-- LEFT: Logo -->
                    <Border Grid.Column="0" Width="32" Height="22"
                            CornerRadius="11"
                            Background="#20FFFFFF"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Cursor="Hand">
                        <PathIcon Data="{StaticResource IconLogo}"
                                  Width="12" Height="12"
                                  Foreground="#00D4FF"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                    </Border>

                    <!-- CENTER: Tabs -->
                    <ScrollViewer Grid.Column="1"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled"
                                  VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="2" Margin="6,0">
                            <ItemsControl ItemsSource="{Binding Tabs}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="2"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TabViewModel">
                                        <Border Classes="tab-pill"
                                                Classes.active="{Binding IsActive}">
                                            <Grid ColumnDefinitions="16,Auto,Auto,16" Margin="8,0">
                                                <!-- Favicon -->
                                                <Panel Grid.Column="0" VerticalAlignment="Center"
                                                       Width="12" Height="12">
                                                    <Ellipse Width="8" Height="8"
                                                             Fill="White"
                                                             IsVisible="{Binding IsLoading}"/>
                                                    <PathIcon Data="{StaticResource IconLogo}"
                                                              Width="11" Height="11"
                                                              Foreground="#B0FFFFFF"
                                                              IsVisible="{Binding IsLoading, Converter={x:Static BoolConverters.Not}}"/>
                                                </Panel>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Title}"
                                                           FontSize="11.5"
                                                           Foreground="White"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxWidth="120"/>
                                                <!-- Close -->
                                                <Button Grid.Column="2"
                                                        Classes="tab-close"
                                                        Margin="4,0,0,0"
                                                        IsVisible="{Binding IsPinned, Converter={x:Static BoolConverters.Not}}"
                                                        Command="{Binding $parent[ItemsControl].((vm:BrowserViewModel)DataContext).CloseTabCommand}"
                                                        CommandParameter="{Binding}">
                                                    <PathIcon Data="{StaticResource IconClose}" Width="7" Height="7"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- New tab + -->
                            <Button Classes="tab-new-btn"
                                    Command="{Binding CreateNewTabCommand}"
                                    ToolTip.Tip="New tab (Ctrl+T)">
                                <PathIcon Data="{StaticResource IconPlus}" Width="11" Height="11"/>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- RIGHT: window controls -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="0,0,2,0">
                        <Button Classes="window-btn" Click="Minimize_Click">
                            <PathIcon Data="{StaticResource IconMinimize}" Width="9" Height="9"/>
                        </Button>
                        <Button Classes="window-btn" Click="Maximize_Click">
                            <PathIcon Data="{StaticResource IconMaximize}" Width="9" Height="9"/>
                        </Button>
                        <Button Classes="window-btn window-btn-close" Click="Close_Click">
                            <PathIcon Data="{StaticResource IconClose}" Width="9" Height="9"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== SIDEBAR (right side, redesigned) ===== -->
            <Border DockPanel.Dock="Left" Width="52"
                    Background="#20000000"
                    IsVisible="{Binding IsSidebarVisible}">
                <DockPanel>
                    <!-- Top: main nav -->
                    <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="4,10,4,0">
                        <ToggleButton Classes="side-btn" IsChecked="True"
                                      Command="{Binding GoHomeCommand}"
                                      ToolTip.Tip="Home">
                            <PathIcon Data="{StaticResource IconHome}" Width="16" Height="16"/>
                        </ToggleButton>
                        <ToggleButton Classes="side-btn"
                                      ToolTip.Tip="Bookmarks">
                            <PathIcon Data="{StaticResource IconBookmarks}" Width="16" Height="16"/>
                        </ToggleButton>
                        <ToggleButton Classes="side-btn"
                                      ToolTip.Tip="History">
                            <PathIcon Data="{StaticResource IconHistory}" Width="16" Height="16"/>
                        </ToggleButton>
                        <ToggleButton Classes="side-btn"
                                      ToolTip.Tip="Downloads">
                            <PathIcon Data="{StaticResource IconDownloads}" Width="16" Height="16"/>
                        </ToggleButton>
                        <ToggleButton Classes="side-btn"
                                      ToolTip.Tip="Collections">
                            <PathIcon Data="{StaticResource IconCollections}" Width="16" Height="16"/>
                        </ToggleButton>
                    </StackPanel>
                    <!-- Spacer -->
                    <Panel/>
                    <!-- Bottom: actions -->
                    <StackPanel DockPanel.Dock="Bottom" Spacing="2" Margin="4,0,4,10">
                        <ToggleButton Classes="side-btn"
                                      Command="{Binding TogglePrivateModeCommand}"
                                      ToolTip.Tip="Private mode">
                            <PathIcon Data="{StaticResource IconIncognito}" Width="16" Height="16"/>
                        </ToggleButton>
                        <ToggleButton Classes="side-btn"
                                      ToolTip.Tip="Settings">
                            <PathIcon Data="{StaticResource IconSettings}" Width="16" Height="16"/>
                        </ToggleButton>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ===== ADDRESS BAR ROW (between tabs and content) ===== -->
            <Border DockPanel.Dock="Top" Height="40"
                    Background="#15000000">
                <Grid ColumnDefinitions="Auto,*,Auto"
                      VerticalAlignment="Center"
                      Margin="4,0">
                    <!-- LEFT side actions -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="1" VerticalAlignment="Center">
                        <Button Classes="tool-btn" Command="{Binding GoBackCommand}" ToolTip.Tip="Back (Alt+Left)">
                            <PathIcon Data="{StaticResource IconBack}" Width="14" Height="14"/>
                        </Button>
                        <Button Classes="tool-btn" Command="{Binding GoForwardCommand}" ToolTip.Tip="Forward (Alt+Right)">
                            <PathIcon Data="{StaticResource IconForward}" Width="14" Height="14"/>
                        </Button>
                        <Button Classes="tool-btn" Command="{Binding ReloadCommand}" ToolTip.Tip="Reload (F5)">
                            <PathIcon Data="{StaticResource IconReload}" Width="14" Height="14"/>
                        </Button>
                        <Button Classes="tool-btn" Command="{Binding GoHomeCommand}" ToolTip.Tip="Home">
                            <PathIcon Data="{StaticResource IconHome}" Width="14" Height="14"/>
                        </Button>
                    </StackPanel>

                    <!-- CENTER: Address/Search Bar -->
                    <controls:Omnibox Grid.Column="1"
                                      x:Name="OmniboxControl"
                                      VerticalAlignment="Center"
                                      Margin="8,0"/>

                    <!-- RIGHT side actions -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="1" VerticalAlignment="Center">
                        <Button Classes="tool-btn" Command="{Binding ToggleBookmarkCommand}" ToolTip.Tip="Bookmark (Ctrl+D)">
                            <PathIcon Data="{StaticResource IconStar}" Width="14" Height="14"/>
                        </Button>
                        <Button Classes="tool-btn"
                                Command="{Binding ToggleDownloadsCommand}"
                                ToolTip.Tip="Downloads">
                            <PathIcon Data="{StaticResource IconDownloads}" Width="14" Height="14"/>
                        </Button>
                        <Button Classes="tool-btn"
                                ToolTip.Tip="Ad blocker">
                            <PathIcon Data="{StaticResource IconShieldCheck}" Width="14" Height="14"/>
                        </Button>
                        <Button Classes="tool-btn"
                                Command="{Binding ToggleSidebarCommand}"
                                ToolTip.Tip="Sidebar (Ctrl+I)">
                            <PathIcon Data="{StaticResource IconSidebar}" Width="14" Height="14"/>
                        </Button>
                        <Button Classes="tool-btn"
                                ToolTip.Tip="AI Assistant">
                            <PathIcon Data="{StaticResource IconSparkle}" Width="14" Height="14"/>
                        </Button>
                        <!-- Divider -->
                        <Border Width="1" Height="16" Background="#20FFFFFF" Margin="2,0"/>
                        <!-- Profile -->
                        <Border Width="26" Height="26" CornerRadius="13"
                                Background="#20FFFFFF" Margin="4,0,6,0"
                                ToolTip.Tip="Profile">
                            <PathIcon Data="{StaticResource IconUser}"
                                      Width="14" Height="14"
                                      Foreground="#C0FFFFFF"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== STATUS BAR (bottom) ===== -->
            <Border DockPanel.Dock="Bottom" Height="20"
                    Background="#20000000">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0"
                               Text="{Binding StatusText}"
                               VerticalAlignment="Center" Margin="12,0"
                               FontSize="10" Foreground="#80FFFFFF"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding ActiveTab.Url}"
                               FontSize="10" Foreground="#60FFFFFF"
                               MaxWidth="300" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                </Grid>
            </Border>

            <!-- ===== CONTENT: CEF browser or New Tab page ===== -->
            <Panel>
                <!-- Browser with rounded corners -->
                <Border CornerRadius="10"
                        Background="Transparent"
                        ClipToBounds="True"
                        Margin="6,0,6,6"
                        IsVisible="{Binding IsNewTabPage, Converter={x:Static BoolConverters.Not}}">
                    <controls:CefBrowserControl x:Name="CefBrowserHost"/>
                </Border>
                <views:NewTabPage DataContext="{Binding}"
                                  IsVisible="{Binding IsNewTabPage}"/>
            </Panel>
        </DockPanel>
    </Panel>
</Window>
