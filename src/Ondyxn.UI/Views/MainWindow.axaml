<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Ondyxn.UI.ViewModels"
        xmlns:views="using:Ondyxn.UI.Views"
        xmlns:controls="using:Ondyxn.UI.Controls"
        x:Class="Ondyxn.UI.Views.MainWindow"
        x:DataType="vm:BrowserViewModel"
        Title="Ondyxn"
        Width="1280" Height="800"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        ExtendClientAreaToDecorationsHint="True"
        SystemDecorations="None">

    <Panel>
        <!-- Full background image -->
        <Image Source="avares://Ondyxn.UI/Assets/background.jpg"
               Stretch="UniformToFill"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               IsHitTestVisible="False"/>
        
        <!-- Dark overlay to make wallpaper darker -->
        <Rectangle Fill="#40000000"
                   IsHitTestVisible="False"/>

        <DockPanel LastChildFill="True">

            <!-- ===== TOP BAR (single row: toolbar + tabs + window controls) ===== -->
            <Border DockPanel.Dock="Top"
                    Background="#30000000"
                    Padding="0">

                <Grid RowDefinitions="Auto,Auto">

                    <!-- Row 0: Compact toolbar with everything on one line -->
                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">

                        <!-- LEFT: Logo + Navigation + Utility icons -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Spacing="1"
                                    Margin="6,4,0,4">

                            <!-- Logo -->
                            <Border Width="26" Height="26" CornerRadius="13"
                                    Background="#25FFFFFF"
                                    Margin="4,0,8,0"
                                    Cursor="Hand">
                                <PathIcon Data="{StaticResource IconLogo}"
                                          Width="14" Height="14"
                                          Foreground="#00D4FF"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                            </Border>

                            <!-- Back -->
                            <Button Classes="tool-btn" Command="{Binding GoBackCommand}"
                                    ToolTip.Tip="Back">
                                <PathIcon Data="{StaticResource IconBack}" Width="14" Height="14"/>
                            </Button>

                            <!-- Forward -->
                            <Button Classes="tool-btn" Command="{Binding GoForwardCommand}"
                                    ToolTip.Tip="Forward">
                                <PathIcon Data="{StaticResource IconForward}" Width="14" Height="14"/>
                            </Button>

                            <!-- Refresh -->
                            <Button Classes="tool-btn" Command="{Binding ReloadCommand}"
                                    ToolTip.Tip="Reload">
                                <PathIcon Data="{StaticResource IconReload}" Width="14" Height="14"/>
                            </Button>

                            <!-- Divider 1 -->
                            <Border Width="1" Height="16" Background="#20FFFFFF" Margin="4,0"/>

                            <!-- Home -->
                            <Button Classes="tool-btn" Command="{Binding GoHomeCommand}"
                                    ToolTip.Tip="Home">
                                <PathIcon Data="{StaticResource IconHome}" Width="14" Height="14"/>
                            </Button>

                            <!-- New Tab -->
                            <Button Classes="tool-btn" Command="{Binding CreateNewTabCommand}"
                                    ToolTip.Tip="New tab (Ctrl+T)">
                                <PathIcon Data="{StaticResource IconPlus}" Width="14" Height="14"/>
                            </Button>

                            <!-- Bookmark -->
                            <Button Classes="tool-btn" Command="{Binding ToggleBookmarkCommand}"
                                    ToolTip.Tip="Bookmark (Ctrl+D)">
                                <PathIcon Data="{StaticResource IconStar}" Width="14" Height="14"/>
                            </Button>

                            <!-- History -->
                            <Button Classes="tool-btn"
                                    ToolTip.Tip="History (Ctrl+H)">
                                <PathIcon Data="{StaticResource IconHistory}" Width="14" Height="14"/>
                            </Button>

                            <!-- Downloads -->
                            <Button Classes="tool-btn" Command="{Binding ToggleDownloadsCommand}"
                                    ToolTip.Tip="Downloads (Ctrl+J)">
                                <PathIcon Data="{StaticResource IconDownloads}" Width="14" Height="14"/>
                            </Button>

                            <!-- Divider 2 -->
                            <Border Width="1" Height="16" Background="#20FFFFFF" Margin="4,0"/>

                            <!-- Shield / Ad Block -->
                            <Button Classes="tool-btn"
                                    ToolTip.Tip="Ad blocker">
                                <PathIcon Data="{StaticResource IconShieldCheck}" Width="14" Height="14"/>
                            </Button>

                            <!-- Sidebar toggle -->
                            <Button Classes="tool-btn" Command="{Binding ToggleSidebarCommand}"
                                    ToolTip.Tip="Sidebar (Ctrl+I)">
                                <PathIcon Data="{StaticResource IconSidebar}" Width="14" Height="14"/>
                            </Button>

                            <!-- Settings -->
                            <Button Classes="tool-btn"
                                    ToolTip.Tip="Settings">
                                <PathIcon Data="{StaticResource IconSettings}" Width="14" Height="14"/>
                            </Button>
                        </StackPanel>

                        <!-- CENTER: Tab pills -->
                        <Border Grid.Column="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <ItemsControl ItemsSource="{Binding Tabs}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="2"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TabViewModel">
                                        <Border Classes="tab-pill"
                                                Classes.active="{Binding IsActive}">
                                            <Panel>
                                                <Grid ColumnDefinitions="Auto,16,Auto" Margin="8,0,4,0">
                                                    
                                                    <!-- Favicon -->
                                                    <PathIcon Grid.Column="0"
                                                              Data="{StaticResource IconLogo}"
                                                              Width="12" Height="12"
                                                              Foreground="#B0FFFFFF"
                                                              VerticalAlignment="Center"
                                                              Margin="0,0,6,0"/>

                                                    <!-- Tab title -->
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding Title}"
                                                               FontSize="11.5"
                                                               Foreground="White"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxWidth="120"/>
                                                </Grid>
                                                
                                                <!-- Close button overlay -->
                                                <Button Classes="tab-close"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center"
                                                        Margin="0,0,2,0"
                                                        Command="{Binding $parent[ItemsControl].((vm:BrowserViewModel)DataContext).CloseTabCommand}"
                                                        CommandParameter="{Binding}">
                                                    <PathIcon Data="{StaticResource IconClose}" Width="7" Height="7"/>
                                                </Button>
                                            </Panel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <!-- RIGHT: Window controls -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="0,0,2,0">
                            <Button Classes="window-btn" Click="Minimize_Click"
                                    ToolTip.Tip="Minimize">
                                <PathIcon Data="{StaticResource IconMinimize}" Width="10" Height="10"/>
                            </Button>
                            <Button Classes="window-btn" Click="Maximize_Click"
                                    ToolTip.Tip="Maximize">
                                <PathIcon Data="{StaticResource IconMaximize}" Width="10" Height="10"/>
                            </Button>
                            <Button Classes="window-btn window-btn-close" Click="Close_Click"
                                    ToolTip.Tip="Close">
                                <PathIcon Data="{StaticResource IconClose}" Width="10" Height="10"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Row 1: Omnibox / Address bar (centered, second row) -->
                    <Border Grid.Row="1"
                            HorizontalAlignment="Center"
                            Padding="0,2,0,6">
                        <controls:Omnibox x:Name="OmniboxControl"
                                         Width="520"
                                         Height="32"/>
                    </Border>
                </Grid>
            </Border>

            <!-- ===== STATUS BAR (bottom) ===== -->
            <Border DockPanel.Dock="Bottom" Height="22"
                    Background="#20000000">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0"
                               Text="{Binding StatusText}"
                               VerticalAlignment="Center"
                               Margin="12,0"
                               FontSize="11"
                               Foreground="#80FFFFFF"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding ActiveTab.Url}"
                               FontSize="11"
                               Foreground="#60FFFFFF"
                               MaxWidth="300"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"/>
                </Grid>
            </Border>

            <!-- ===== CONTENT: CEF browser or New Tab page ===== -->
            <Panel>
                <!-- Browser with rounded corners -->
                <Border CornerRadius="10"
                        Background="Transparent"
                        ClipToBounds="True"
                        Margin="6,0,6,6"
                        IsVisible="{Binding IsBrowserVisible}">
                    <controls:CefBrowserControl x:Name="CefBrowserHost"/>
                </Border>
                <views:NewTabPage DataContext="{Binding}"
                                  IsVisible="{Binding IsNewTabPage}"/>
            </Panel>
        </DockPanel>
    </Panel>
</Window>
