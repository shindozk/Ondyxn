<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ondyxn.UI.ViewModels"
             x:Class="Ondyxn.UI.Views.CommandPalette"
             x:DataType="vm:CommandPaletteViewModel"
             IsVisible="{Binding IsOpen}">

    <!-- Full-screen overlay -->
    <Border Background="#B0000000" IsHitTestVisible="True">
        <Panel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,120,0,0"
               Width="520" MaxHeight="420">
            <Border Background="#F00E1419" BorderBrush="#3000D4FF" BorderThickness="1"
                    CornerRadius="16" ClipToBounds="True"
                    BoxShadow="0 24 48 0 #40000000">
                <DockPanel>
                    <!-- Search input -->
                    <Border DockPanel.Dock="Top" Padding="16,12"
                            BorderBrush="#15FFFFFF" BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <PathIcon Grid.Column="0" Data="{StaticResource IconSearch}"
                                      Width="18" Height="18"
                                      Foreground="#60FFFFFF"
                                      VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding SearchText}"
                                     FontSize="15" FontFamily="Inter, Segoe UI"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="White"
                                     Watermark="Type a command..."
                                     KeyDown="OnSearchKeyDown"/>
                            <Border Grid.Column="2" Background="#15FFFFFF" CornerRadius="4"
                                        Padding="6,2" VerticalAlignment="Center">
                                <TextBlock Text="Esc"
                                           FontSize="11" Foreground="#40FFFFFF"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Commands list -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="340">
                        <ItemsControl ItemsSource="{Binding FilteredCommands}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PaletteCommand">
                                    <Border Padding="14,10" Margin="4,1"
                                            CornerRadius="8"
                                            Background="Transparent"
                                            PointerEntered="OnCommandHover"
                                            Tag="{Binding $parent[ItemsControl].((vm:CommandPaletteViewModel)DataContext)}">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="13" FontWeight="Medium"
                                                           Foreground="#E0FFFFFF"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Description}"
                                                           FontSize="11"
                                                           Foreground="#50FFFFFF"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <Border Grid.Column="1" Padding="6,3"
                                                    Background="#15FFFFFF" CornerRadius="4"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Shortcut}"
                                                           FontSize="10" FontWeight="Medium"
                                                           Foreground="#80FFFFFF"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Panel>
    </Border>
</UserControl>
